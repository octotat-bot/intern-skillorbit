# ---------------------------------------------------------------------------
# Backend environment — copy to .env and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Upload
MAX_FILE_SIZE_MB=5

# Database (SQLite file path, relative to backend/)
DATABASE_PATH=instance/resumes.db

# CORS — comma-separated allowed origins (the frontend dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- RAG / AI mode (Phase 5) — OPTIONAL. Leave GEMINI_API_KEY blank to disable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Embedding backend for RAG retrieval: tfidf | sentence-transformers | gemini
EMBEDDING_PROVIDER=tfidf
# Used only when EMBEDDING_PROVIDER=sentence-transformers
ST_MODEL_NAME=all-MiniLM-L6-v2
