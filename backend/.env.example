# ---------------------------------------------------------------------------
# Backend environment — copy to .env and fill in. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Flask
FLASK_ENV=development
FLASK_DEBUG=1
PORT=5000

# Upload
MAX_FILE_SIZE_MB=5

# Database (SQLite file path, relative to backend/)
DATABASE_PATH=instance/resumes.db

# CORS — comma-separated allowed origins (the frontend dev server by default)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- RAG / AI mode — OPTIONAL. Without GEMINI_API_KEY the app runs in rules
# mode and AI mode returns ai_available=false with the retrieved guidance.
LLM_PROVIDER=gemini            # gemini | none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TIMEOUT_SECONDS=25

# Retrieval embeddings: tfidf (local, default, no key) | gemini (needs key; index rebuilt in memory)
EMBEDDING_PROVIDER=tfidf
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
